libwebpdemux | libwebp-dev | libwebpdemux2
libwebpmux | libwebp-dev | libwebpmux3
libzstd | libzstd-dev | libzstd1
pixman-1 | libpixman-1-dev | libpixman-1-0
libpng | libpng-dev | libpng16-16 libpng16-16t64
zlib | zlib1g-dev | zlib1g
xau | libxau-dev | libxau6
xdmcp | libxdmcp-dev | libxdmcp6
xrender | libxrender-dev | libxrender1
