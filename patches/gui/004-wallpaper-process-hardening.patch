+var (
+	wallpaperLogMu    sync.Mutex
+	wallpaperLogFiles = map[string]*log.Logger{}
+)
+
+func wallpaperLogPath(screen string) string {
+	safe := strings.Map(func(r rune) rune {
+		switch {
+		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9',
+			r == '-', r == '_', r == '.':
+			return r
+		}
+		return '-'
+	}, screen)
+	return "/tmp/lwe-forge-engine-" + safe + ".log"
+}
+
+func teeWallpaperLog(screen, msg string) {
+	wallpaperLogMu.Lock()
+	defer wallpaperLogMu.Unlock()
+	writer, exists := wallpaperLogFiles[screen]
+	if !exists {
+		file, err := os.OpenFile(wallpaperLogPath(screen), os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)
+		if err != nil {
+			return
+		}
+		writer = log.New(file, "", log.LstdFlags)
+		wallpaperLogFiles[screen] = writer
+	}
+	writer.Printf("%s: %s", screen, msg)
+}
