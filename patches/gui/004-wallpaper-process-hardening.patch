+func stopWallpaperProcess(active *ActiveWallpaper) {
+	pid := active.Cmd.Process.Pid
+	signalProcessGroup(pid, syscall.SIGTERM)
+	if waitExit(active, killGracePeriod) {
+		return
+	}
+	logger.Printf("Wallpaper pid %d survived SIGTERM (%v grace), escalating to SIGKILL", pid, killGracePeriod)
+	signalProcessGroup(pid, syscall.SIGKILL)
+	if !waitExit(active, killGracePeriod) {
+		logger.Printf("Wallpaper pid %d still alive after SIGKILL", pid)
+	}
+}
+
+func waitExit(active *ActiveWallpaper, timeout time.Duration) bool {
+	select {
+	case <-active.done:
+		return true
+	case <-time.After(timeout):
+		return false
+	}
+}
+
+func signalProcessGroup(pid int, sig syscall.Signal) {
+	if pgid, err := syscall.Getpgid(pid); err == nil {
+		if err := syscall.Kill(-pgid, sig); err == nil {
+			return
+		}
+	}
+	_ = syscall.Kill(pid, sig)
+}
+
+func (manager *Manager) reapOrphanEngines() {
+	tracked := make(map[int]bool, len(manager.activeWallpapers))
+	for _, active := range manager.activeWallpapers {
+		if active.Cmd.Process != nil {
+			tracked[active.Cmd.Process.Pid] = true
+		}
+	}
+	for _, pid := range findEnginePids() {
+		if tracked[pid] {
+			continue
+		}
+		logger.Printf("Reaping orphan wallpaper engine pid %d", pid)
+		_ = syscall.Kill(pid, syscall.SIGKILL)
+	}
+}
+
+func findEnginePids() []int {
+	var pids []int
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return nil
+	}
+	for _, entry := range entries {
+		pid, err := strconv.Atoi(entry.Name())
+		if err != nil {
+			continue
+		}
+		cmdline, err := os.ReadFile("/proc/" + entry.Name() + "/cmdline")
+		if err != nil || len(cmdline) == 0 {
+			continue
+		}
+		fields := strings.Split(strings.TrimRight(string(cmdline), "\x00"), "\x00")
+		if filepath.Base(fields[0]) == engineBinaryName {
+			pids = append(pids, pid)
+		}
+	}
+	return pids
+}
