 X11FullScreenDetector::~X11FullScreenDetector () { this->stop (); }
 
+static bool windowHasNetWmState (Display* display, Window window, const char* stateName) {
+    Atom actualType = None;
+    int actualFormat = 0;
+    unsigned long nitems = 0, bytesAfter = 0;
+    unsigned char* data = nullptr;
+
+    const Atom stateAtom = XInternAtom (display, "_NET_WM_STATE", False);
+    const Atom wantAtom = XInternAtom (display, stateName, False);
+
+    if (XGetWindowProperty (display, window, stateAtom, 0, 32, False, XA_ATOM, &actualType, &actualFormat,
+			    &nitems, &bytesAfter, &data) != Success || data == nullptr) {
+	return false;
+    }
+
+    bool found = false;
+    const unsigned long* atoms = reinterpret_cast<const unsigned long*> (data);
+    for (unsigned long i = 0; i < nitems; i++) {
+	if (atoms[i] == static_cast<unsigned long> (wantAtom)) {
+	    found = true;
+	    break;
+	}
+    }
+
+    XFree (data);
+    return found;
+}
