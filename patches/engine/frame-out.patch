+void WallpaperApplication::captureFrameOut () {
+    const auto& wallpapers = this->m_renderContext->getWallpapers ();
+    if (wallpapers.empty ()) {
+	return;
+    }
+
+    const auto& viewports = this->m_renderContext->getOutput ().getViewports ();
+    if (viewports.empty ()) {
+	return;
+    }
+
+    const auto& wallpaper = wallpapers.begin ()->second;
+    const uint32_t width = static_cast<uint32_t> (this->m_renderContext->getOutput ().getFullWidth ());
+    const uint32_t height = static_cast<uint32_t> (this->m_renderContext->getOutput ().getFullHeight ());
+    if (static_cast<uint32_t> (wallpaper->getWidth ()) < width
+	|| static_cast<uint32_t> (wallpaper->getHeight ()) < height) {
+	return;
+    }
+
+    viewports.begin ()->second->makeCurrent ();
+    FrameSource::capture (this->m_context.settings.frameOut.path, wallpaper->getWallpaperFramebuffer (), width, height, FrameSource::RowOrder::TopDown, this->m_frameOut);
+}
