+
+	    this->settings.render.mode = FRAMESINK;
+
+	    const char* str = value.c_str ();
+	    const char* delim = strchr (str, 'x');
+
+	    if (delim == nullptr) {
+		sLog.exception ("Framesink resolution must be in the format: WxH");
+	    }
+
+	    this->settings.render.framesink.width = static_cast<uint32_t> (strtol (str, nullptr, 10));
+	    this->settings.render.framesink.height = static_cast<uint32_t> (strtol (delim + 1, nullptr, 10));
+
+	    if (this->settings.render.framesink.width == 0 || this->settings.render.framesink.height == 0) {
+		sLog.exception ("Framesink resolution must be in the format: WxH");
+	    }
+	})
+	.append ();
+
     auto& contentGroup = program.add_group ("Content options");
 
     contentGroup.add_argument ("--assets-dir")
