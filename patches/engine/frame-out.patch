+
+    auto& framesinkGroup = program.add_group ("Framesink options");
+
+    framesinkGroup.add_argument ("--framesink")
+	.help ("Headless render at WxH resolution without any window, exporting frames via --frame-out")
+	.action ([this] (const std::string& value) -> void {
+	    if (this->settings.render.mode == DESKTOP_BACKGROUND) {
+		sLog.exception ("Cannot run in both background and framesink mode");
