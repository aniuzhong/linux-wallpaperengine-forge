+    frameOutGroup.add_argument ("--frame-out")
+	.help ("Streams every rendered frame into a shared memory file for external display frontends")
+	.default_value ("")
+	.action ([this] (const std::string& value) -> void {
+	    this->settings.frameOut.enabled = true;
