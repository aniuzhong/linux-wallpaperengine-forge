# dep-spec.list — kare 环境构建依赖的声明式清单
#
# 格式: pc名 | dev包候选(空格分隔,按序尝试) | 运行时包候选(空格分隔,可空)
#   - pc名     : pkg-config 模块名; "-" 表示无 pc 的纯头文件/工具包 (总是安装)
#   - dev包候选: 闭包循环发现缺此 pc 时按序尝试下载的 -dev 包
#   - 运行时包 : 链接期需要 .so.N (符号链接的目标), 从中 dpkg -x 提取
#
# 维护约定: 新增依赖时在此登记, shims 会于下次构建自动重建
# (dep-spec.list 的 mtime 触发重建, 见 kare-env.sh ensure_dep_shims)
#
# ---- 引擎 (build-engine.sh 探测清单) ----
- | libglm-dev |
# openKylin 的 freeglut3-dev 是空过渡壳 (Depends: libglut-dev), 真文件在后者
- | libglut-dev freeglut3-dev libglu1-mesa-dev |
mpv | libmpv-dev | libmpv2 libmpv1
glfw3 | libglfw3-dev | libglfw3
glew | libglew-dev | libglew2.2 libglew2.1
sdl2 | libsdl2-dev | libsdl2-2.0-0
liblz4 | liblz4-dev | liblz4-1
libavcodec | libavcodec-dev | libavcodec60 libavcodec59 libavcodec58
libavformat | libavformat-dev | libavformat60 libavformat59 libavformat58
libavutil | libavutil-dev | libavutil58 libavutil57 libavutil56
libswscale | libswscale-dev | libswscale7 libswscale6 libswscale5
libpulse | libpulse-dev | libpulse0
fftw3 | libfftw3-dev | libfftw3-double3 libfftw3-3
dbus-1 | libdbus-1-dev | libdbus-1-3
gmp | libgmp-dev | libgmp10
egl | libegl-dev | libegl1
gl | libgl-dev | libgl1
opengl | libopengl-dev | libopengl0
# ---- GUI (build-gui.sh 探测清单) ----
gtk+-3.0 | libgtk-3-dev | libgtk-3-0 libgtk-3-0t64
ayatana-appindicator3-0.1 | libayatana-appindicator3-dev | libayatana-appindicator3-1
glib-2.0 | libglib2.0-dev | libglib2.0-0 libglib2.0-0t64
gobject-2.0 | libglib2.0-dev | libglib2.0-0 libglib2.0-0t64
gio-2.0 | libglib2.0-dev | libglib2.0-0 libglib2.0-0t64
